# KING REAPER X — example environment file
#
# Copy to .env and fill in only what you need, or export the variables in your
# shell. Every provider below is OPTIONAL: without a key the corresponding
# module returns a "degraded" result that names the variable and how to get it.
# It never invents data to fill the gap.
#
# .env is git-ignored. Never commit a real key.
#
# Load it with:   set -a; . ./.env; set +a

# --- optional: phone carrier + reachability ----------------------------------
# https://numverify.com  (free tier: 100 requests/month)
NUMVERIFY_API_KEY=

# --- optional: WhatsApp public business profile ------------------------------
# Meta WhatsApp Business Cloud API. A system-user token with the
# whatsapp_business_management scope is required.
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- optional: threat intelligence -------------------------------------------
# https://www.virustotal.com  (free tier available)
VIRUSTOTAL_API_KEY=
# https://www.abuseipdb.com   (free tier available)
ABUSEIPDB_API_KEY=
# https://www.shodan.io       (paid; adds open-port intelligence)
SHODAN_API_KEY=

# --- optional: geolocation ---------------------------------------------------
# https://ipinfo.io           (free tier; the keyless source works without it)
IPINFO_TOKEN=

# --- runtime behaviour (all optional) ----------------------------------------
# Accept the authorized-use terms non-interactively (CI/cron).
REAPER_ACCEPT_TERMS=
# Never prompt even when a tty is present.
REAPER_NONINTERACTIVE=
# Where config, logs and the database live.
REAPER_CONFIG_DIR=
# Where generated reports go.
REAPER_REPORT_DIR=
# Default requests-per-second ceiling.
REAPER_RATE_LIMIT=8
# Default per-request timeout in seconds.
REAPER_TIMEOUT=8
# Disable colour (set to any value).
NO_COLOR=
